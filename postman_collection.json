    {
      "name": "1. Appointment Creation & Corner Cases",
      "description": "Validation of appointment booking across different lead-time windows and contact combinations.",
      "item": [
        {
          "name": "1.1 Standard Booking (>24h out -> 24h & 2h Reminders)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response has Content-Type application/json\", function () {",
                  "    pm.response.to.have.header(\"Content-Type\");",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test(\"Response contains valid Appointment ID and customer\", function () {",
                  "    pm.expect(data).to.have.property(\"id\").that.is.a(\"number\");",
                  "    pm.expect(data.customerName).to.eql(\"Eleanor Vance\");",
                  "    pm.expect(data.status).to.eql(\"SCHEDULED\");",
                  "    pm.expect(data.dealershipName).to.be.a(\"string\");",
                  "    pm.collectionVariables.set(\"appointmentId\", data.id);",
                  "});",
                  "pm.test(\"Both 24-hour and 2-hour reminders are eagerly scheduled\", function () {",
                  "    pm.expect(data.reminders).to.be.an(\"array\").with.lengthOf(2);",
                  "    var types = data.reminders.map(function(r) { return r.reminderType; });",
                  "    pm.expect(types).to.include(\"HOURS_24\");",
                  "    pm.expect(types).to.include(\"HOURS_2\");",
                  "    data.reminders.forEach(function(r) {",
                  "        pm.expect(r.status).to.eql(\"PENDING\");",
                  "        pm.expect(r.scheduledAt).to.be.a(\"string\");",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dealershipId\": 1,\n  \"customerName\": \"Eleanor Vance\",\n  \"customerEmail\": \"eleanor.vance@example.com\",\n  \"customerPhone\": \"+1-555-0101\",\n  \"vehicleInfo\": \"2024 Honda CR-V (VIN: 7FA23G0192)\",\n  \"serviceType\": \"10,000-Mile Scheduled Maintenance\",\n  \"scheduledAt\": \"2026-09-18T10:30:00Z\"\n}"
            },
            "url": {
